# Optional: cloud sync across devices via Supabase.
# Without these the app runs fully local (drawings stored in this browser's IndexedDB).
#
# Project Settings → API:
#   Project URL           -> VITE_SUPABASE_URL
#   Publishable key       -> VITE_SUPABASE_PUBLISHABLE_KEY   (sb_publishable_...)
# (A legacy anon JWT key also works via VITE_SUPABASE_ANON_KEY.)
#
# Never put a secret / service_role key here: everything prefixed VITE_ is shipped to the browser.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: set to true to show "Create an account instead" in the sign-in form. Use it once to
# create your account (or create it in the Supabase dashboard), then remove it and turn off
# "Allow new users to sign up" in Supabase Auth settings.
VITE_ALLOW_SIGNUP=
