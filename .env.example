# Nothing needs configuring for the usual setup: the server (npm start / Docker) serves the app
# and the sync API on one origin, and `npm run dev` embeds the same API.
#
# ---- Web app (build time, read by Vite) ----
# Where the sync server is: unset = the origin that serves the app; 'off' = no sync (drawings
# stay on the device); or a URL such as https://chart.example.com
# VITE_SYNC_SERVER=
#
# ---- Sync server (runtime: npm start / Docker) ----
# PORT=8080
# HOST=                       # bind address; default all interfaces
# DATA_DIR=data               # /data in Docker
# DB_FILE=                    # default $DATA_DIR/draw-a-chart.sqlite
# STATIC_DIR=dist
# MAX_ROWS=100000             # live drawings per user
# ALLOWED_ORIGINS=            # extra origins for the live connection (only if a proxy rewrites Host)
# REQUEST_LOG=1               # log each request (debugging Cloudflare Access; no tokens or identities)
#
# ---- Market data (runtime: npm start / Docker / npm run dev) ----
# US stocks and ETFs from Alpaca: a free paper-account key works (app.alpaca.markets > Paper
# Trading > API Keys). Without it the app charts crypto only. Never commit the real values.
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
# ALPACA_FEED=delayed_sip      # free: every exchange, 15 min late; sip = real time (paid plan)
# MARKET_DB_FILE=              # bar cache, default $DATA_DIR/market.sqlite (.data/market.sqlite in dev)
# MARKET_DATA=off              # no /api/market (the e2e servers run like this)
#
# ---- Dev server ----
# SYNC_DEV_DB=.data/dev.sqlite   # ':memory:' for a throwaway database
